using "ui/basic.style";
using "ui/widgets/widgets.style";
using "settings/settings.style";
using "info/info.style";
using "ui/chat/chat.style";
using "calls/calls.style";

// A message's menu: its edit history (a clock with a pen, as Android's).
novagramMenuIconEditHistory: icon {{ "menu/edited_status", menuIconColor }};

// Settings > Novagram > About: the header.
novagramAboutLogoTop: 24px;
novagramAboutLogoSize: 96px;
novagramAboutNameTop: 14px;
novagramAboutName: FlatLabel(defaultFlatLabel) {
	textFg: windowBoldFg;
	align: align(top);
	style: TextStyle(defaultTextStyle) {
		font: font(20px semibold);
	}
}
novagramAboutTaglineTop: 4px;
novagramAboutTagline: FlatLabel(defaultFlatLabel) {
	textFg: windowSubTextFg;
	align: align(top);
	style: TextStyle(defaultTextStyle) {
		font: font(14px);
	}
}
novagramAboutHeaderBottom: 22px;

// Its rows: the title, and under it the value on a line of its own, so the
// value is never cut however narrow the window or long the title.
novagramAboutRow: SettingsButton(settingsButton) {
	padding: margins(60px, 9px, 22px, 9px);
}
novagramAboutValueSkip: 1px;
novagramAboutValueFont: font(13px);
novagramAboutValueFg: windowActiveTextFg;

// A chat's "Deleted messages" screen.
novagramDeletedClear: IconButton(infoTopBarMenu) {
	icon: icon {{ "menu/delete", boxTitleCloseFg }};
	iconOver: icon {{ "menu/delete", boxTitleCloseFgOver }};
	iconPosition: point(-1px, -1px);
}
novagramDeletedSubtitle: FlatLabel(defaultFlatLabel) {
	textFg: windowSubTextFg;
	maxHeight: 20px;
	style: TextStyle(defaultTextStyle) {
		font: font(13px);
	}
}
novagramDeletedNameSkip: 2px;
novagramDeletedDateSkip: 2px;
novagramDeletedEmptyWidth: 300px;
novagramDeletedEmptyPadding: margins(16px, 12px, 16px, 13px);
novagramDeletedEmptySkip: 4px;
novagramDeletedEmptyTitleFont: font(14px semibold);

// The voice changer button above a locked recording, as Android's (Material
// Icons "record_voice_over"): white on a filled circle while an effect is on.
novagramVoiceChangerIcon: icon {{ "voice_lock/voice_changer-22x22", historyToDownFg }};
novagramVoiceChangerIconOn: icon {{ "voice_lock/voice_changer-22x22", windowFgActive }};
novagramVoiceChangerOnRadius: 16px;

// A call window's dark voice changer boxes: the value next to a slider.
novagramCallVoiceValue: FlatLabel(settingsScaleLabel) {
	textFg: groupCallMembersFg;
}

// A call window's voice changer button, next to its "pin on top" (among
// the title's buttons or in the corner), lit while an effect is on.
novagramCallTitleVoice: IconButton(callTitlePinOnTop) {
	icon: icon {{ "voice_lock/voice_changer-16x16", callNameFg, point(10px, 4px) }};
	iconOver: icon {
		{ windowTitleButtonSize, callBgButton },
		{ windowTitleButtonSize, callMuteRipple },
		{ "voice_lock/voice_changer-16x16", callNameFg, point(10px, 4px) },
	};
}
novagramCallTitleVoiceOn: icon {{ "voice_lock/voice_changer-16x16", groupCallActiveFg, point(10px, 4px) }};
novagramCallTitleVoiceOnOver: icon {
	{ windowTitleButtonSize, callBgButton },
	{ windowTitleButtonSize, callMuteRipple },
	{ "voice_lock/voice_changer-16x16", groupCallActiveFg, point(10px, 4px) },
};
novagramCallVoice: IconButton(callPinOnTop) {
	icon: icon {{ "voice_lock/voice_changer-16x16", callStatusFg, point(10px, 4px) }};
	iconOver: icon {{ "voice_lock/voice_changer-16x16", callNameFg, point(10px, 4px) }};
}
novagramCallVoiceOn: icon {{ "voice_lock/voice_changer-16x16", groupCallActiveFg, point(10px, 4px) }};
